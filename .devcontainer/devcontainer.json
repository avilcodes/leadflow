{
  "name": "LeadFlow Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [3000, 6379],
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "remoteEnv": {
    "FIREBASE_PROJECT_ID": "${localEnv:FIREBASE_PROJECT_ID}",
    "FIREBASE_CLIENT_EMAIL": "${localEnv:FIREBASE_CLIENT_EMAIL}",
    "FIREBASE_PRIVATE_KEY": "${localEnv:FIREBASE_PRIVATE_KEY}",
    "REDIS_URL": "redis://redis:6379",
    "AUTH_SECRET": "dev-secret-change-in-production-32chars",
    "NEXTAUTH_URL": "http://localhost:3000",
    "APP_URL": "http://localhost:3000",
    "NODE_ENV": "development",
    "EMAIL_SENDING_ENABLED": "false"
  }
}
