generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String    @map("password_hash")
  role           String    @default("user") // admin, user
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  campaigns      Campaign[]
  activities     Activity[]
  apiCredentials ApiCredential[]

  @@map("users")
}

// ─── Leads ───

model Lead {
  id                String    @id @default(cuid())
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  fullName          String?   @map("full_name")
  jobTitle          String?   @map("job_title")
  email             String?
  phone             String?
  linkedinUrl       String?   @map("linkedin_url")
  location          String?
  website           String?

  // Company info
  companyName       String?   @map("company_name")
  companyDomain     String?   @map("company_domain")
  companyLinkedinUrl String?  @map("company_linkedin_url")
  industry          String?
  companySize       String?   @map("company_size")
  revenue           String?
  funding           String?

  // Status tracking
  status            String    @default("new") // new, contacted, qualified, converted, lost
  enrichmentStatus  String    @default("pending") @map("enrichment_status") // pending, in_progress, completed, failed, partial
  outreachStatus    String    @default("none") @map("outreach_status") // none, draft, ready, sent, delivered, opened, replied, bounced

  // Source tracking
  source            String?   // apollo, prospeo, deepenrich, csv, manual
  sourceLeadId      String?   @map("source_lead_id")
  importedAt        DateTime? @map("imported_at")
  rawSourceData     Json?     @map("raw_source_data")

  // Custom metadata for provider-specific fields
  customFields      Json?     @map("custom_fields")

  // Do not contact
  doNotContact      Boolean   @default(false) @map("do_not_contact")
  unsubscribed      Boolean   @default(false)
  bounced           Boolean   @default(false)
  suppressionReason String?   @map("suppression_reason")

  // Timestamps
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  company           Company?  @relation(fields: [companyId], references: [id])
  companyId         String?   @map("company_id")

  enrichmentJobs    EnrichmentJob[]
  aiAnalyses        AiAnalysis[]
  emailMessages     EmailMessage[]
  activities        Activity[]
  campaignLeads     CampaignLead[]
  leadTags          LeadTag[]
  sourceRecords     LeadSourceRecord[]

  @@unique([email], map: "leads_email_unique")
  @@index([linkedinUrl], map: "leads_linkedin_url_idx")
  @@index([companyName], map: "leads_company_name_idx")
  @@index([status], map: "leads_status_idx")
  @@index([enrichmentStatus], map: "leads_enrichment_status_idx")
  @@index([outreachStatus], map: "leads_outreach_status_idx")
  @@index([source], map: "leads_source_idx")
  @@index([createdAt], map: "leads_created_at_idx")
  @@index([deletedAt], map: "leads_deleted_at_idx")
  @@map("leads")
}

// ─── Companies ───

model Company {
  id              String    @id @default(cuid())
  name            String
  domain          String?   @unique
  linkedinUrl     String?   @map("linkedin_url")
  website         String?
  industry        String?
  size            String?
  revenue         String?
  funding         String?
  description     String?
  location        String?
  foundedYear     Int?      @map("founded_year")
  customFields    Json?     @map("custom_fields")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  leads           Lead[]

  @@index([name], map: "companies_name_idx")
  @@map("companies")
}

// ─── Lead Source Records ───

model LeadSourceRecord {
  id            String   @id @default(cuid())
  leadId        String   @map("lead_id")
  provider      String   // apollo, prospeo, deepenrich, csv, manual
  sourceLeadId  String?  @map("source_lead_id")
  rawData       Json?    @map("raw_data")
  importBatchId String?  @map("import_batch_id")
  importedAt    DateTime @default(now()) @map("imported_at")

  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([provider], map: "lead_source_records_provider_idx")
  @@index([importBatchId], map: "lead_source_records_batch_idx")
  @@map("lead_source_records")
}

// ─── Tags ───

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String?
  createdAt DateTime  @default(now()) @map("created_at")

  leadTags  LeadTag[]

  @@map("tags")
}

model LeadTag {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@map("lead_tags")
}

// ─── Enrichment ───

model EnrichmentJob {
  id              String    @id @default(cuid())
  leadId          String    @map("lead_id")
  provider        String    // apify, custom
  actorId         String?   @map("actor_id")
  providerJobId   String?   @map("provider_job_id")
  type            String    // linkedin_scrape, website_scrape, company_info, custom
  status          String    @default("pending") // pending, running, completed, failed
  input           Json?
  rawOutput       Json?     @map("raw_output")
  normalizedOutput Json?    @map("normalized_output")
  errorMessage    String?   @map("error_message")
  retryCount      Int       @default(0) @map("retry_count")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId], map: "enrichment_jobs_lead_id_idx")
  @@index([status], map: "enrichment_jobs_status_idx")
  @@index([providerJobId], map: "enrichment_jobs_provider_job_id_idx")
  @@map("enrichment_jobs")
}

// ─── AI Analysis ───

model AiAnalysis {
  id                String    @id @default(cuid())
  leadId            String    @map("lead_id")
  provider          String    @default("openrouter") // openrouter, openai, etc.
  model             String    // model identifier
  promptVersion     String?   @map("prompt_version")
  inputData         Json?     @map("input_data")
  rawResponse       Json?     @map("raw_response")

  // Structured analysis output
  personSummary     String?   @map("person_summary")
  companySummary    String?   @map("company_summary")
  currentContext    String?   @map("current_context")
  signals           Json?     // key signals array
  painPoints        Json?     @map("pain_points")
  priorities        Json?     // business priorities
  personalizations  Json?     // personalization opportunities
  outreachAngle     String?   @map("outreach_angle")
  relevanceReasons  Json?     @map("relevance_reasons")
  confidenceScore   Float?    @map("confidence_score")

  status            String    @default("pending") // pending, running, completed, failed
  errorMessage      String?   @map("error_message")
  tokensUsed        Int?      @map("tokens_used")
  costEstimate      Float?    @map("cost_estimate")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId], map: "ai_analyses_lead_id_idx")
  @@index([status], map: "ai_analyses_status_idx")
  @@map("ai_analyses")
}

// ─── Campaigns ───

model Campaign {
  id              String    @id @default(cuid())
  name            String
  description     String?
  status          String    @default("draft") // draft, ready, running, paused, completed, failed

  // Sending config
  senderName      String?   @map("sender_name")
  senderEmail     String?   @map("sender_email")
  replyToEmail    String?   @map("reply_to_email")

  // AI config
  objective       String?
  targetAudience  String?   @map("target_audience")
  productDescription String? @map("product_description")
  valueProposition String?  @map("value_proposition")
  tone            String?   @default("professional")
  emailLength     String?   @default("medium") @map("email_length") // short, medium, long
  cta             String?
  customInstructions String? @map("custom_instructions")
  aiModel         String?   @map("ai_model")

  // Sequence config
  channel         String    @default("email") // email, linkedin, whatsapp, sms
  sequenceSteps   Int       @default(1) @map("sequence_steps")
  delayBetweenEmails Int?   @map("delay_between_emails") // hours
  sendingWindow   String?   @map("sending_window")
  timezone        String?   @default("UTC")

  // Rate limiting
  maxPerHour      Int?      @map("max_per_hour")
  maxPerDay       Int?      @map("max_per_day")

  // Auto-approve
  autoApprove     Boolean   @default(false) @map("auto_approve")

  // Stats (denormalized for performance)
  totalLeads      Int       @default(0) @map("total_leads")
  emailsGenerated Int       @default(0) @map("emails_generated")
  emailsSent      Int       @default(0) @map("emails_sent")
  emailsDelivered Int       @default(0) @map("emails_delivered")
  emailsOpened    Int       @default(0) @map("emails_opened")
  emailsClicked   Int       @default(0) @map("emails_clicked")
  emailsReplied   Int       @default(0) @map("emails_replied")
  emailsBounced   Int       @default(0) @map("emails_bounced")

  startedAt       DateTime? @map("started_at")
  pausedAt        DateTime? @map("paused_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdById     String?   @map("created_by_id")
  createdBy       User?     @relation(fields: [createdById], references: [id])

  campaignLeads   CampaignLead[]
  emailMessages   EmailMessage[]

  @@index([status], map: "campaigns_status_idx")
  @@map("campaigns")
}

model CampaignLead {
  id              String    @id @default(cuid())
  campaignId      String    @map("campaign_id")
  leadId          String    @map("lead_id")
  status          String    @default("pending") // pending, email_generated, approved, sent, completed, failed, skipped
  sequenceStep    Int       @default(1) @map("sequence_step")
  addedAt         DateTime  @default(now()) @map("added_at")

  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@map("campaign_leads")
}

// ─── Email Messages ───

model EmailMessage {
  id                String    @id @default(cuid())
  campaignId        String?   @map("campaign_id")
  leadId            String    @map("lead_id")
  sequenceStep      Int       @default(1) @map("sequence_step")

  // Content
  subject           String?
  htmlBody          String?   @map("html_body")
  textBody          String?   @map("text_body")

  // AI generation metadata
  aiModel           String?   @map("ai_model")
  aiPrompt          Json?     @map("ai_prompt")
  aiRawResponse     Json?     @map("ai_raw_response")

  // Status
  status            String    @default("draft") // draft, generated, edited, approved, rejected, queued, sending, sent, delivered, failed
  approvedAt        DateTime? @map("approved_at")
  rejectedAt        DateTime? @map("rejected_at")
  rejectionReason   String?   @map("rejection_reason")

  // Sending
  senderName        String?   @map("sender_name")
  senderEmail       String?   @map("sender_email")
  recipientEmail    String?   @map("recipient_email")
  recipientName     String?   @map("recipient_name")

  // Provider tracking
  provider          String?   // brevo
  providerMessageId String?   @map("provider_message_id")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  openedAt          DateTime? @map("opened_at")
  clickedAt         DateTime? @map("clicked_at")
  repliedAt         DateTime? @map("replied_at")
  bouncedAt         DateTime? @map("bounced_at")
  unsubscribedAt    DateTime? @map("unsubscribed_at")
  errorMessage      String?   @map("error_message")

  channel           String    @default("email") // email, linkedin, whatsapp, sms

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailEvents       EmailEvent[]

  @@index([campaignId], map: "email_messages_campaign_id_idx")
  @@index([leadId], map: "email_messages_lead_id_idx")
  @@index([status], map: "email_messages_status_idx")
  @@index([providerMessageId], map: "email_messages_provider_msg_id_idx")
  @@map("email_messages")
}

// ─── Email Events ───

model EmailEvent {
  id                String    @id @default(cuid())
  emailMessageId    String    @map("email_message_id")
  eventType         String    @map("event_type") // delivered, opened, clicked, bounced, replied, unsubscribed, complained, deferred
  provider          String?   // brevo
  providerEventId   String?   @map("provider_event_id")
  metadata          Json?
  occurredAt        DateTime  @map("occurred_at")
  processedAt       DateTime  @default(now()) @map("processed_at")

  emailMessage      EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@unique([providerEventId, eventType], map: "email_events_idempotent")
  @@index([emailMessageId], map: "email_events_message_id_idx")
  @@index([eventType], map: "email_events_type_idx")
  @@map("email_events")
}

// ─── Activity / Events ───

model Activity {
  id              String    @id @default(cuid())
  eventType       String    @map("event_type")
  leadId          String?   @map("lead_id")
  campaignId      String?   @map("campaign_id")
  emailMessageId  String?   @map("email_message_id")
  userId          String?   @map("user_id")
  provider        String?
  providerEventId String?   @map("provider_event_id")
  metadata        Json?
  errorInfo       Json?     @map("error_info")
  createdAt       DateTime  @default(now()) @map("created_at")

  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType], map: "activities_event_type_idx")
  @@index([leadId], map: "activities_lead_id_idx")
  @@index([campaignId], map: "activities_campaign_id_idx")
  @@index([createdAt], map: "activities_created_at_idx")
  @@index([providerEventId], map: "activities_provider_event_id_idx")
  @@map("activities")
}

// ─── API Credentials / Integration Config ───

model ApiCredential {
  id            String    @id @default(cuid())
  provider      String    @unique // apollo, prospeo, deepenrich, apify, openrouter, brevo
  encryptedKey  String    @map("encrypted_key")
  config        Json?     // additional provider config
  isActive      Boolean   @default(true) @map("is_active")
  lastTestedAt  DateTime? @map("last_tested_at")
  testStatus    String?   @map("test_status") // connected, failed, untested
  createdById   String?   @map("created_by_id")
  createdBy     User?     @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("api_credentials")
}

// ─── Background Jobs ───

model BackgroundJob {
  id            String    @id @default(cuid())
  type          String    // lead_import, enrichment, ai_analysis, email_generation, campaign_send, webhook_process
  status        String    @default("pending") // pending, running, completed, failed, dead
  payload       Json?
  result        Json?
  errorMessage  String?   @map("error_message")
  retryCount    Int       @default(0) @map("retry_count")
  maxRetries    Int       @default(3) @map("max_retries")
  runAfter      DateTime? @map("run_after")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([type, status], map: "background_jobs_type_status_idx")
  @@index([runAfter], map: "background_jobs_run_after_idx")
  @@map("background_jobs")
}

// ─── Webhook Events ───

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String    // brevo
  eventType       String    @map("event_type")
  providerEventId String?   @map("provider_event_id")
  payload         Json?
  status          String    @default("received") // received, processing, processed, failed
  errorMessage    String?   @map("error_message")
  processedAt     DateTime? @map("processed_at")
  receivedAt      DateTime  @default(now()) @map("received_at")

  @@unique([provider, providerEventId], map: "webhook_events_idempotent")
  @@index([provider, eventType], map: "webhook_events_provider_type_idx")
  @@map("webhook_events")
}

// ─── Suppression List ───

model SuppressionEntry {
  id        String    @id @default(cuid())
  email     String    @unique
  reason    String    // unsubscribed, bounced, complained, manual
  source    String?   // brevo_webhook, manual, import
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("suppression_list")
}
