# ──────────────────────────────────────
# LeadFlow Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────

# ─── Firebase (Database) ───
# Option 1: Full service account JSON (recommended for production)
FIREBASE_SERVICE_ACCOUNT=""
# Option 2: Individual credentials
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─── Redis (for background jobs) ───
REDIS_URL="redis://localhost:6379"

# ─── Authentication ───
AUTH_SECRET="generate-a-random-32-char-string-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Application ───
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Apollo.io ───
APOLLO_API_KEY=""

# ─── Prospeo ───
PROSPEO_API_KEY=""

# ─── Deepenrich ───
DEEPENRICH_API_KEY=""

# ─── Apify (enrichment/scraping) ───
APIFY_API_KEY=""
APIFY_LINKEDIN_ACTOR_ID="apify/linkedin-profile-scraper"
APIFY_WEBSITE_ACTOR_ID="apify/website-content-crawler"

# ─── OpenRouter (AI) ───
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="anthropic/claude-sonnet-4"

# ─── Brevo (email sending) ───
BREVO_API_KEY=""
BREVO_WEBHOOK_SECRET=""

# ─── Email Sending Safety ───
# Set to "true" to enable actual email sending (default: false)
EMAIL_SENDING_ENABLED="false"
# Maximum emails per hour (rate limiting)
EMAIL_RATE_LIMIT_PER_HOUR="50"
# Sending window (24h format, e.g., "09:00-17:00")
EMAIL_SENDING_WINDOW="09:00-17:00"
# Sending timezone
EMAIL_SENDING_TIMEZONE="UTC"
